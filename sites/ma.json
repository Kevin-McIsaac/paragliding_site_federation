  {
    "id": "PSF-018229",
    "ref": "pge:6820-lz",
    "name": "Nid d'Aigle Landing",
    "lat": 29.704,
    "lon": -9.936,
    "wind": {},
    "altitude": 70.0,
    "sources": {
      "pge": "6820-lz"
    },
    "primary": "pge",
    "role": "landing",
    "tow": false,
    "group": [
      "pge:6820"
    ],
    "notes": "Alt: 60m on the road to takeoff.\nAVOID landing in planted fields, as this will jeopardize this site!\nThere are lots of barren fields around to land in!\nTop-landing possible.\n\nHike-and-fly takes about 40 minutes from the dunes to the launch. From the road to the dunes, cross the main road and head up-slope (avoiding fields) to find a switchback trail that intersects the road up just below the main switchback. Regain the trail at the main switchback and follow it up to the ridge, a few hundred meters south of the launch. the trail reaches a N-S road behind the launch.",
    "url": "https://www.paraglidingearth.com/?site=6820"
  },
  {
    "id": "PSF-018230",
